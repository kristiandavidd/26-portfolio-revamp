{
  "name": "kristian-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portfolio": "npm run dev --workspace @repo/portfolio",
    "dev:manage": "npm run dev --workspace @repo/manage",
    "dev:personal": "npm run dev --workspace @repo/personal",
    "build:portfolio": "npm run build --workspace @repo/portfolio",
    "build:manage": "npm run build --workspace @repo/manage",
    "build:personal": "npm run build --workspace @repo/personal",
    "build": "npm run build:portfolio && npm run build:manage && npm run build:personal",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "assets:upload": "node --env-file-if-exists=.env packages/db/scripts/upload-assets.mjs",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}