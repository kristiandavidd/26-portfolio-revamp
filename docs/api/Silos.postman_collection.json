            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "upload"
              ]
            },
            "description": "Upload a file. Multipart form-data with `file` (required) and optional `folder_id`. Saves the new id into the `fileId` variable."
          },
          "response": []
