            "description": "Get all API keys accessible by the logged in user, including the project data."
          },
          "response": []
        },
        {
          "name": "Create API Key (Project)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  if (json.data.id) { pm.collectionVariables.set(\"apiKeyId\", json.data.id); }",
                  "  if (json.data.key) { pm.collectionVariables.set(\"apiKey\", json.data.key); }",
                  "  if (json.data.project_id) { pm.collectionVariables.set(\"projectId\", json.data.project_id); }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"production-key\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "api-keys"
              ]
            },
            "description": "Create an API key for a project. The generated key is prefixed with `silos_` and is stored into the `apiKey` variable."
          },
          "response": []
