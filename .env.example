# Environment
# Copy to .env at the repo root and fill in. The root file is read by every app
# locally; on Vercel each project gets its own copy of the variables it needs.

# ---------------------------------------------------------------------------
# Postgres (Neon)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Silos (object storage)
# ---------------------------------------------------------------------------
SILOS_API_URL=https://silos.example.com
SILOS_API_KEY=silos_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Echo (transactional email)
# ---------------------------------------------------------------------------
ECHO_API_URL=https://echo.example.com
ECHO_API_KEY=echo_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional verified sender in Echo; leave empty to use Echo's default.
ECHO_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Panel auth (manage app)
# ---------------------------------------------------------------------------
AUTH_SECRET=generate-a-64-character-random-hex-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# ---------------------------------------------------------------------------
# Public app URLs (baked into the client at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PORTFOLIO_URL=https://kristiandav.id
NEXT_PUBLIC_PERSONAL_URL=https://personal.kristiandav.id
NEXT_PUBLIC_MANAGE_URL=https://manage.kristiandav.id
